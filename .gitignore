# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

temp

.vscode

# merged file for LLM analysis
pangraphx-core/merged.rs

.Ds_Store

.idea
.claude

# giant gfa files are downloaded with a script and are not needed in the repo
ecoli50.gfa
chr22.hprc-v1.1-mc-grch38.gfa
benchmarks/data/

# benchmark runs (one timestamped directory per run, see benchmarks/README.md)
benchmarks/results/

# Derived test fixtures (VG/GBZ/FASTG/OG) are generated from the committed GFA
# files by utils/generate_test_files.sh; only GFA is checked in.
pangraphx-core/tests/test_files/vg/
pangraphx-core/tests/test_files/gbz/
pangraphx-core/tests/test_files/og/
pangraphx-core/tests/test_files/fastg/*.fastg
# Hand-authored FASTG source fixture (not derived from GFA) stays in-repo.
!pangraphx-core/tests/test_files/fastg/assembly_graph.fastg