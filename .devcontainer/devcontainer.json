{
  "name": "Rust Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/rust:1",

  "features": {
    
  },

  "postCreateCommand": ".devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "github.copilot",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }

}
